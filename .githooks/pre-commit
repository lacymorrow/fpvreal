#!/bin/sh
# Refuses a commit signed by an address that has no business in a public
# repository. Two real accidents are the reason this guard exists:
#
#   - a global identity left at `test <test>`: 442 commits signed by an invalid
#     address, attached to no GitHub account;
#   - a personal address used on 6 commits, which had to be removed by
#     rewriting the whole history — an operation that changes every SHA, and
#     that GitHub's `refs/pull/*` keep the old commits from anyway.
#
# Enable in a fresh clone:  git config core.hooksPath .githooks
#
# This allowlist is deliberately short. A contributor adding themselves puts
# THEIR commit address in it (their account's, `noreply` for preference).

ALLOWED='106342136+lionrayonnant@users\.noreply\.github\.com|noreply@anthropic\.com|[0-9]+\+[A-Za-z0-9-]+@users\.noreply\.github\.com'

refuse() {
	echo "pre-commit: commit address refused: $1" >&2
	echo "" >&2
	echo "  This repository is public. Configure an address that does not expose you:" >&2
	echo "    git config user.email '<id>+<account>@users.noreply.github.com'" >&2
	echo "" >&2
	echo "  If this address is legitimate, add it to ALLOWED in" >&2
	echo "  .githooks/pre-commit — that is a decision, not a formality." >&2
	exit 1
}

author=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
committer=$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')

echo "$author" | grep -qE "^($ALLOWED)$" || refuse "$author (author)"
echo "$committer" | grep -qE "^($ALLOWED)$" || refuse "$committer (committer)"
