# systemd unit for the FPVTP! game server on the VPS (`shared` mode).
#
# Slice T4 of the deployment design:
# sim/docs/superpowers/specs/2026-09-07-dual-mode-deployment-design.md
#
# Installation: see deploy/README.md (human checklist, done once).
#   cp deploy/fpvtp.service /etc/systemd/system/fpvtp.service
#   systemctl daemon-reload && systemctl enable --now fpvtp
#
# Layout expected on the machine (laid down by deploy/deploy.sh):
#   /opt/fpvtp/releases/<tag>/app/     ← the program (server/, tools/, src/, dist/)
#   /opt/fpvtp/releases/<tag>/node/    ← the Node runtime embedded in the archive
#   /opt/fpvtp/current -> releases/<tag>   (symbolic link, the switch)
#   /var/lib/fpvtp/                    ← the data (FPVTP_DATA_DIR)
#
# That shape is what .github/workflows/release.yml publishes as the
# `fpvtp-server-<tag>-linux-x64.tar.gz` asset. A release older than that
# workflow only carries `dist/` and this unit will not start on it — see
# deploy/README.md, section "The Node runtime".

[Unit]
Description=FPVTP! — game server (shared mode)
Documentation=https://github.com/lionrayonnant/FPVThePlanet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fpvtp
Group=fpvtp

WorkingDirectory=/opt/fpvtp/current/app
ExecStart=/opt/fpvtp/current/node/bin/node server/index.mjs

# The four variables below are the ones sim/server/index.mjs actually reads
# (resolveOptions(), lines 51-58): FPVTP_DATA_DIR, FPVTP_PORT, FPVTP_HOST,
# FPVTP_MODE. Verified by starting the server with them, on 2026-09-07.
#
# `shared` is the VPS mode: it is what allows listening outside the loopback
# and what carries operator-key authentication.
Environment=FPVTP_MODE=shared
# The data lives outside the program directory: an update overwrites
# /opt/fpvtp/current, never /var/lib/fpvtp.
Environment=FPVTP_DATA_DIR=/var/lib/fpvtp
# We listen ONLY on the loopback: Caddy is what exposes the service to the
# world, with the TLS. Nothing must reach port 8080 from outside.
Environment=FPVTP_HOST=127.0.0.1
Environment=FPVTP_PORT=8080

# Behind Cloudflare (or any CDN), uncomment this so the server reads the
# visitor's real address from CF-Connecting-IP instead of seeing every visitor
# as the CDN edge — which would make the signup limit five per hour for the
# whole internet rather than per person.
#
# DO NOT uncomment it until 80 and 443 are firewalled to Cloudflare's ranges
# (deploy/README.md, "Behind Cloudflare"). While the origin answers anyone,
# that header is whatever the caller typed, and trusting it is worse than
# ignoring it.
# Environment=FPVTP_TRUST_CF_IP=1
#
# FPVTP_ACQUIRE IS DELIBERATELY NOT SET, AND MUST NEVER BE SET HERE.
# It is the flag that opens `ACQUIRE AREA` (a scene being born on disk, calls
# to kh.google.com from the server). The design (D2) wants it closed on the VPS
# without exception: nothing ever acquires terrain on this machine, it only
# serves LIVE flight. Do not add it "just to test".
#
# The design also mentions an FPVTP_SCENES_MAX_GB variable: it DOES NOT EXIST
# in the code (no occurrence anywhere in sim/, checked by grep on 2026-09-07).
# It is therefore not set here — an invented variable would have been silent
# and useless. Without acquisition there is no scene to cap anyway.

Restart=on-failure
RestartSec=2

# Logging: everything goes to journalctl -u fpvtp.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fpvtp

# --- Hardening -------------------------------------------------------------
# The server only needs to read its own program directory and to write into its
# data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fpvtp
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# Rapier is WASM: V8 needs writable executable pages, so MemoryDenyWriteExecute
# stays at `no`. It is the only common hardening switch deliberately left out,
# and it is left out for a precise reason.
RemoveIPC=yes
# IPv4/IPv6 and Unix sockets: nothing else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
